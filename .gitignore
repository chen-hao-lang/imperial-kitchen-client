# ==============================================
# KitchenChaos-Study —— 仅提交 Assets/Scripts 文件夹
# 其余内容一律忽略
# ==============================================

# 1. 忽略仓库根目录下的所有内容
/*

# 2. 保留 .gitignore 自身（否则规则无法生效）
!.gitignore

# 3. 放行 Assets 目录本身，以便进入其中
!/Assets/

# 4. 忽略 Assets 下的所有其他内容（场景、Prefab、材质、贴图等）
/Assets/*

# 5. 放行 Scripts 文件夹及其全部内容（含 .meta，Unity 必需）
!/Assets/Scripts/
!/Assets/Scripts/**